{
  "name": "starlight",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "latest",
    "@vitest/coverage-istanbul": "^5.0.5",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
